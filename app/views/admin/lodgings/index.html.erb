<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Lodgings</h1>
  <%= link_to 'New Lodging', new_admin_lodging_path, class: 'btn btn-primary btn-sm' %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-sm align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Plan</th>
        <th>Description</th>
        <th>Cost</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @lodgings.each do |lodging| %>
        <tr>
          <td><%= link_to lodging.id, admin_lodging_path(lodging) %></td>
          <td><%= lodging.plan %></td>
          <td><%= lodging.description %></td>
          <td><%= number_to_currency(lodging.cost) %></td>
          <td class="text-nowrap">
            <%= link_to 'Edit', edit_admin_lodging_path(lodging), class: 'btn btn-link btn-sm' %>
            <%= button_to 'Delete', admin_lodging_path(lodging), method: :delete, class: 'btn btn-link btn-sm text-danger', form: { data: { turbo_confirm: 'Are you sure?' } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
