<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Gender #<%= @gender.id %></h1>
  <div>
    <%= link_to 'Edit', edit_admin_gender_path(@gender), class: 'btn btn-primary btn-sm' %>
    <%= link_to 'Back', admin_genders_path, class: 'btn btn-outline-secondary btn-sm' %>
  </div>
</div>

<dl class="row">
  <dt class="col-sm-3">Name</dt>
  <dd class="col-sm-9"><%= @gender.name %></dd>
  <dt class="col-sm-3">Description</dt>
  <dd class="col-sm-9"><%= @gender.description %></dd>
  <dt class="col-sm-3">Created</dt>
  <dd class="col-sm-9"><%= l(@gender.created_at, format: :long) if @gender.created_at %></dd>
  <dt class="col-sm-3">Updated</dt>
  <dd class="col-sm-9"><%= l(@gender.updated_at, format: :long) if @gender.updated_at %></dd>
</dl>
