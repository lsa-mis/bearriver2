<%= form_with model: [:admin, partner_registration], class: 'card card-body' do |f| %>
  <%= render 'admin/shared/errors', resource: partner_registration %>
  <div class="mb-3">
    <%= f.label :description, class: 'form-label' %>
    <%= f.text_field :description, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= f.label :cost, class: 'form-label' %>
    <%= f.number_field :cost, class: 'form-control', step: 0.01 %>
  </div>
  <div class="mb-3 form-check">
    <%= f.check_box :active, class: 'form-check-input' %>
    <%= f.label :active, class: 'form-check-label' %>
  </div>
  <div class="d-flex gap-2">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to 'Cancel', admin_partner_registrations_path, class: 'btn btn-outline-secondary' %>
  </div>
<% end %>
