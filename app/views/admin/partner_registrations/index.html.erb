<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Partner Registrations</h1>
  <%= link_to 'New Partner Registration', new_admin_partner_registration_path, class: 'btn btn-primary btn-sm' %>
</div>

<div class="table-responsive">
  <table class="table table-striped table-sm align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Description</th>
        <th>Cost</th>
        <th>Active</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @partner_registrations.each do |pr| %>
        <tr>
          <td><%= link_to pr.id, admin_partner_registration_path(pr) %></td>
          <td><%= pr.description %></td>
          <td><%= number_to_currency(pr.cost) %></td>
          <td><%= pr.active %></td>
          <td class="text-nowrap">
            <%= link_to 'Edit', edit_admin_partner_registration_path(pr), class: 'btn btn-link btn-sm' %>
            <%= button_to 'Delete', admin_partner_registration_path(pr), method: :delete, class: 'btn btn-link btn-sm text-danger', form: { data: { turbo_confirm: 'Are you sure?' } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
