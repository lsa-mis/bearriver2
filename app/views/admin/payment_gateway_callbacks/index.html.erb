<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Gateway Callbacks</h1>
</div>

<%= form_with url: admin_payment_gateway_callbacks_path, method: :get, local: true, class: 'row g-2 mb-3' do %>
  <div class="col-md-3">
    <%= text_field_tag :transaction_id, params[:transaction_id], class: 'form-control form-control-sm', placeholder: 'Transaction ID' %>
  </div>
  <div class="col-md-3">
    <%= select_tag :processing_status, options_for_select(PaymentGatewayCallback::PROCESSING_STATUSES, params[:processing_status]), include_blank: 'Processing Status', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-3">
    <%= submit_tag 'Filter', class: 'btn btn-sm btn-outline-secondary' %>
    <%= link_to 'Clear', admin_payment_gateway_callbacks_path, class: 'btn btn-sm btn-link' %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-sm align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Transaction ID</th>
        <th>Status</th>
        <th>Event Type</th>
        <th>User</th>
        <th>Payment</th>
        <th>Failure Reason</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% @callbacks.each do |callback| %>
        <tr>
          <td><%= link_to callback.id, admin_payment_gateway_callback_path(callback) %></td>
          <td><%= callback.transaction_id %></td>
          <td><%= callback.processing_status %></td>
          <td><%= callback.event_type %></td>
          <td><%= callback.user&.email %></td>
          <td><%= link_to("##{callback.payment_id}", admin_payment_path(callback.payment)) if callback.payment %></td>
          <td><%= truncate(callback.failure_reason.to_s, length: 80) %></td>
          <td><%= l(callback.created_at, format: :long) if callback.created_at %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
