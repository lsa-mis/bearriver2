<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Users</h1>
  <%= link_to 'New User', new_admin_user_path, class: 'btn btn-primary btn-sm' %>
</div>

<%= form_with url: admin_users_path, method: :get, local: true, class: 'row g-2 mb-3' do %>
  <div class="col-auto">
    <%= select_tag :email, options_for_select(User.order(:email).pluck(:email), params[:email]), include_blank: 'Email', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-auto">
    <%= submit_tag 'Filter', class: 'btn btn-sm btn-outline-secondary' %>
    <%= link_to 'Clear', admin_users_path, class: 'btn btn-sm btn-link' %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-sm align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Email</th>
        <th>Current Sign In</th>
        <th>Sign In Count</th>
        <th>Created</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= link_to user.id, admin_user_path(user) %></td>
          <td><%= user.email %></td>
          <td><%= l(user.current_sign_in_at, format: :long) if user.current_sign_in_at %></td>
          <td><%= user.sign_in_count %></td>
          <td><%= l(user.created_at, format: :long) if user.created_at %></td>
          <td class="text-nowrap">
            <%= link_to 'Edit', edit_admin_user_path(user), class: 'btn btn-link btn-sm' %>
            <%= button_to 'Delete', admin_user_path(user), method: :delete, class: 'btn btn-link btn-sm text-danger', form: { data: { turbo_confirm: 'Are you sure?' } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
