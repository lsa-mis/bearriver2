<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">User #<%= @user.id %></h1>
  <div>
    <%= link_to 'Edit', edit_admin_user_path(@user), class: 'btn btn-primary btn-sm' %>
    <%= link_to 'Back', admin_users_path, class: 'btn btn-outline-secondary btn-sm' %>
  </div>
</div>

<dl class="row">
  <dt class="col-sm-3">Email</dt>
  <dd class="col-sm-9"><%= @user.email %></dd>
  <dt class="col-sm-3">Sign In Count</dt>
  <dd class="col-sm-9"><%= @user.sign_in_count %></dd>
  <dt class="col-sm-3">Current Sign In</dt>
  <dd class="col-sm-9"><%= l(@user.current_sign_in_at, format: :long) if @user.current_sign_in_at %></dd>
  <dt class="col-sm-3">Created</dt>
  <dd class="col-sm-9"><%= l(@user.created_at, format: :long) if @user.created_at %></dd>
</dl>
