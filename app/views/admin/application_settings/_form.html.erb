<%= form_with model: [:admin, application_setting], class: 'card card-body' do |f| %>
  <%= render 'admin/shared/errors', resource: application_setting %>

  <div class="mb-3 form-check">
    <%= f.check_box :active_application, class: 'form-check-input',
          onclick: "return confirm('#{j t('admin.application_settings.active_application.confirm_message')}')" %>
    <%= f.label :active_application, class: 'form-check-label' %>
  </div>

  <div class="row g-3">
    <div class="col-md-4">
      <%= f.label :contest_year, 'Conference Year', class: 'form-label' %>
      <%= f.number_field :contest_year, class: 'form-control' %>
    </div>
    <div class="col-md-4">
      <%= f.label :opendate, class: 'form-label' %>
      <%= f.datetime_local_field :opendate, class: 'form-control' %>
    </div>
    <div class="col-md-4">
      <%= f.label :time_zone, class: 'form-label' %>
      <%= f.text_field :time_zone, class: 'form-control' %>
    </div>
    <div class="col-md-4">
      <%= f.label :application_open_period, '# of Hours App is OPEN', class: 'form-label' %>
      <%= f.number_field :application_open_period, class: 'form-control' %>
    </div>
    <div class="col-md-4">
      <%= f.label :lottery_buffer, class: 'form-label' %>
      <%= f.number_field :lottery_buffer, class: 'form-control' %>
    </div>
    <div class="col-md-4">
      <%= f.label :application_buffer, class: 'form-label' %>
      <%= f.number_field :application_buffer, class: 'form-control' %>
    </div>
    <div class="col-md-4">
      <%= f.label :registration_fee, class: 'form-label' %>
      <%= f.number_field :registration_fee, class: 'form-control', step: 0.01 %>
    </div>
    <div class="col-md-4">
      <%= f.label :subscription_cost, class: 'form-label' %>
      <%= f.number_field :subscription_cost, class: 'form-control' %>
    </div>
  </div>

  <% %i[
    application_open_directions application_closed_directions registration_acceptance_directions
    special_scholarship_acceptance_directions payments_directions subscription_directions
    application_confirm_email_message lottery_won_email special_offer_invite_email
    lottery_lost_email balance_due_email_message
  ].each do |attr| %>
    <div class="mb-3 mt-3">
      <%= f.label attr, class: 'form-label' %>
      <%= f.text_area attr, class: 'form-control', rows: 3 %>
    </div>
  <% end %>

  <div class="mb-3 form-check">
    <%= f.check_box :allow_payments, class: 'form-check-input' %>
    <%= f.label :allow_payments, class: 'form-check-label' %>
  </div>
  <div class="mb-3 form-check">
    <%= f.check_box :allow_lottery_winner_emails, class: 'form-check-input' %>
    <%= f.label :allow_lottery_winner_emails, class: 'form-check-label' %>
  </div>
  <div class="mb-3 form-check">
    <%= f.check_box :allow_lottery_loser_emails, class: 'form-check-input' %>
    <%= f.label :allow_lottery_loser_emails, class: 'form-check-label' %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to 'Cancel', admin_application_settings_path, class: 'btn btn-outline-secondary' %>
  </div>
<% end %>
