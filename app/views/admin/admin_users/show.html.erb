<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Admin User #<%= @admin_user.id %></h1>
  <div>
    <%= link_to 'Edit', edit_admin_admin_user_path(@admin_user), class: 'btn btn-primary btn-sm' %>
    <%= link_to 'Back', admin_admin_users_path, class: 'btn btn-outline-secondary btn-sm' %>
  </div>
</div>

<dl class="row">
  <dt class="col-sm-3">Email</dt>
  <dd class="col-sm-9"><%= @admin_user.email %></dd>
  <dt class="col-sm-3">Created</dt>
  <dd class="col-sm-9"><%= l(@admin_user.created_at, format: :long) if @admin_user.created_at %></dd>
</dl>
