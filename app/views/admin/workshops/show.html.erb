<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Workshop #<%= @workshop.id %></h1>
  <div>
    <%= link_to 'Edit', edit_admin_workshop_path(@workshop), class: 'btn btn-primary btn-sm' %>
    <%= link_to 'Back', admin_workshops_path, class: 'btn btn-outline-secondary btn-sm' %>
  </div>
</div>

<dl class="row">
  <dt class="col-sm-3">Active</dt>
  <dd class="col-sm-9"><%= @workshop.active %></dd>
  <dt class="col-sm-3">Instructor</dt>
  <dd class="col-sm-9"><%= @workshop.instructor %></dd>
  <dt class="col-sm-3">Last Name</dt>
  <dd class="col-sm-9"><%= @workshop.last_name %></dd>
  <dt class="col-sm-3">First Name</dt>
  <dd class="col-sm-9"><%= @workshop.first_name %></dd>
</dl>
