<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Workshops</h1>
  <%= link_to 'New Workshop', new_admin_workshop_path, class: 'btn btn-primary btn-sm' %>
</div>

<%= form_with url: admin_workshops_path, method: :get, local: true, class: 'row g-2 mb-3' do %>
  <div class="col-auto">
    <%= select_tag :last_name, options_for_select(Workshop.distinct.order(:last_name).pluck(:last_name), params[:last_name]), include_blank: 'Last name', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-auto">
    <%= select_tag :active, options_for_select([['Active', 'true'], ['Inactive', 'false']], params[:active]), include_blank: 'Active?', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-auto">
    <%= submit_tag 'Filter', class: 'btn btn-sm btn-outline-secondary' %>
    <%= link_to 'Clear', admin_workshops_path, class: 'btn btn-sm btn-link' %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-sm align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Active</th>
        <th>Instructor</th>
        <th>Last Name</th>
        <th>First Name</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @workshops.each do |workshop| %>
        <tr>
          <td><%= link_to workshop.id, admin_workshop_path(workshop) %></td>
          <td><%= workshop.active %></td>
          <td><%= workshop.instructor %></td>
          <td><%= workshop.last_name %></td>
          <td><%= workshop.first_name %></td>
          <td class="text-nowrap">
            <%= link_to 'Edit', edit_admin_workshop_path(workshop), class: 'btn btn-link btn-sm' %>
            <%= button_to 'Delete', admin_workshop_path(workshop), method: :delete, class: 'btn btn-link btn-sm text-danger', form: { data: { turbo_confirm: 'Are you sure?' } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
