<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h1 class="h3 mb-0">Payments</h1>
  <div class="d-flex gap-2">
    <%= link_to 'Download CSV', admin_payments_path(request.query_parameters.merge(format: :csv)), class: 'btn btn-outline-secondary btn-sm' %>
    <%= link_to 'New Manual Payment', new_admin_payment_path, class: 'btn btn-primary btn-sm' %>
  </div>
</div>

<ul class="nav nav-tabs mb-3">
  <li class="nav-item">
    <%= link_to 'Current Conference', admin_payments_path(scope: nil), class: "nav-link#{' active' if params[:scope].blank?}" %>
  </li>
  <li class="nav-item">
    <%= link_to 'All', admin_payments_path(scope: 'all'), class: "nav-link#{' active' if params[:scope] == 'all'}" %>
  </li>
</ul>

<%= form_with url: admin_payments_path, method: :get, local: true, class: 'row g-2 mb-3' do %>
  <%= hidden_field_tag :scope, params[:scope] if params[:scope].present? %>
  <div class="col-md-3">
    <%= select_tag :payer_identity, options_for_select(Payment.order(:payer_identity).distinct.pluck(:payer_identity), params[:payer_identity]), include_blank: 'User Email', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-2">
    <%= select_tag :conf_year, options_for_select(Payment.order(:conf_year).distinct.pluck(:conf_year), params[:conf_year]), include_blank: 'Conf Year', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-2">
    <%= select_tag :account_type, options_for_select(Payment.order(:account_type).distinct.pluck(:account_type).compact, params[:account_type]), include_blank: 'Account Type', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-3">
    <%= submit_tag 'Filter', class: 'btn btn-sm btn-outline-secondary' %>
    <%= link_to 'Clear', admin_payments_path(scope: params[:scope]), class: 'btn btn-sm btn-link' %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-sm align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>User</th>
        <th>Conf Year</th>
        <th>Type</th>
        <th>Amount</th>
        <th>Status</th>
        <th>Date</th>
        <th>Account Type</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @payments.each do |payment| %>
        <tr>
          <td><%= link_to payment.id, admin_payment_path(payment) %></td>
          <td><%= payment.user&.email %></td>
          <td><%= payment.conf_year %></td>
          <td><%= payment.transaction_type %></td>
          <td><%= number_to_currency(payment.total_amount.to_f / 100) %></td>
          <td><%= payment.transaction_status %></td>
          <td><%= payment.transaction_date %></td>
          <td><%= payment.account_type %></td>
          <td><%= link_to 'View', admin_payment_path(payment), class: 'btn btn-link btn-sm' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
