<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h1 class="h3 mb-0">Applications</h1>
  <div class="d-flex gap-2">
    <%= link_to 'Download CSV', admin_applications_path(request.query_parameters.merge(format: :csv)), class: 'btn btn-outline-secondary btn-sm' %>
    <%= link_to 'New Application', new_admin_application_path, class: 'btn btn-primary btn-sm' %>
  </div>
</div>

<ul class="nav nav-tabs mb-3">
  <li class="nav-item">
    <%= link_to 'Current years Applications', admin_applications_path(scope: nil), class: "nav-link#{' active' if params[:scope].blank?}" %>
  </li>
  <li class="nav-item">
    <%= link_to 'All', admin_applications_path(scope: 'all'), class: "nav-link#{' active' if params[:scope] == 'all'}" %>
  </li>
  <li class="nav-item">
    <%= link_to 'Subscription Selected', admin_applications_path(scope: 'subscription_selected'), class: "nav-link#{' active' if params[:scope] == 'subscription_selected'}" %>
  </li>
</ul>

<%= form_with url: admin_applications_path, method: :get, local: true, class: 'row g-2 mb-3' do %>
  <%= hidden_field_tag :scope, params[:scope] if params[:scope].present? %>
  <div class="col-md-2">
    <%= select_tag :user_email, options_for_select(User.joins(:applications).distinct.order(:email).pluck(:email), params[:user_email]), include_blank: 'User Email', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-2">
    <%= select_tag :last_name, options_for_select(Application.distinct.order(:last_name).pluck(:last_name), params[:last_name]), include_blank: 'Last Name', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-2">
    <%= select_tag :first_name, options_for_select(Application.distinct.order(:first_name).pluck(:first_name), params[:first_name]), include_blank: 'First Name', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-2">
    <%= select_tag :offer_status, options_for_select(offer_status, params[:offer_status]), include_blank: 'Offer Status', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-2">
    <%= select_tag :conf_year, options_for_select(Application.distinct.order(:conf_year).pluck(:conf_year), params[:conf_year]), include_blank: 'Conf Year', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-md-2">
    <%= select_tag :lodging_selection, options_for_select(Lodging.order(:description).pluck(:description), params[:lodging_selection]), include_blank: 'Lodging', class: 'form-select form-select-sm' %>
  </div>
  <div class="col-12">
    <%= submit_tag 'Filter', class: 'btn btn-sm btn-outline-secondary' %>
    <%= link_to 'Clear', admin_applications_path(scope: params[:scope]), class: 'btn btn-sm btn-link' %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-sm align-middle">
    <thead>
      <tr>
        <th></th>
        <th>Offer Status</th>
        <th>Balance Due</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Lottery Position</th>
        <th>Workshop 1</th>
        <th>Workshop 2</th>
        <th>Workshop 3</th>
        <th>Lodging</th>
        <th>Partner</th>
        <th>Birth Year</th>
      </tr>
    </thead>
    <tbody>
      <% @applications.each do |application| %>
        <tr>
          <td class="text-nowrap">
            <%= link_to 'View', admin_application_path(application), class: 'btn btn-link btn-sm' %>
            <%= link_to 'Edit', edit_admin_application_path(application), class: 'btn btn-link btn-sm' %>
          </td>
          <td><%= application.offer_status %></td>
          <td>
            <%= number_to_currency(application.balance_due_with_batch(payments_totals: @payments_total_by_user_and_year, lodgings_by_desc: @lodgings_by_description)) %>
          </td>
          <td><%= application.first_name %></td>
          <td><%= application.last_name %></td>
          <td><%= application.lottery_position %></td>
          <td><%= application.workshop_selection1 %></td>
          <td><%= application.workshop_selection2 %></td>
          <td><%= application.workshop_selection3 %></td>
          <td><%= application.lodging_selection %></td>
          <td><%= application.partner_registration&.display_name %></td>
          <td><%= application.birth_year %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
