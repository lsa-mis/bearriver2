<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= content_for?(:title) ? yield(:title) : 'Admin' %> | Bear River Application</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", preload_links_header: false %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload", preload_links_header: false %>
  <%= Sentry.get_trace_propagation_meta.html_safe %>
</head>
<body class="admin-body bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <%= link_to 'Bearriver Application', admin_root_path, class: 'navbar-brand' %>
      <div class="d-flex align-items-center gap-3">
        <%= link_to 'View Site', root_path, class: 'nav-link text-white' %>
        <% if admin_user_signed_in? %>
          <span class="text-white-50 small"><%= current_admin_user.email %></span>
          <%= button_to 'Logout', destroy_admin_user_session_path, method: :delete, class: 'btn btn-sm btn-outline-light' %>
        <% end %>
      </div>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="row">
      <% if admin_user_signed_in? %>
        <aside class="col-md-3 col-lg-2 border-end bg-white min-vh-100 py-3 px-0">
          <%= render 'layouts/admin_nav' %>
        </aside>
        <main class="col-md-9 col-lg-10 py-4 px-4">
          <%= render 'layouts/notifications' %>
          <%= yield %>
        </main>
      <% else %>
        <main class="col-12 py-5">
          <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
              <%= render 'layouts/notifications' %>
              <%= yield %>
            </div>
          </div>
        </main>
      <% end %>
    </div>
  </div>
</body>
</html>
